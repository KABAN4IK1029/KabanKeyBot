# ============================================================================
# KABAN KEY BOT — Конфигурация
# Скопируйте этот файл в .env и заполните значения
# ============================================================================

# Токен Telegram-бота (получите у @BotFather)
TELEGRAM_BOT_TOKEN=ВАШ_ТОКЕН_БОТА_ЗДЕСЬ

# AWS настройки
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=ВАШ_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=ВАШ_SECRET_ACCESS_KEY

# Имена DynamoDB таблиц (оставьте по умолчанию, если не меняли при деплое)
DYNAMODB_TABLE_KEYS=kaban_keys
DYNAMODB_TABLE_USERS=kaban_users
DYNAMODB_TABLE_SETTINGS=kaban_settings

# Префикс ключей (может менять только админ через бота)
# Формат ключа: PREFIX-XXXX-XXXX-XXXX
DEFAULT_KEY_PREFIX=KABAN4IK1029

# Админ ID (оставьте пустым — первый пользователь станет админом автоматически)
ADMIN_USER_ID=